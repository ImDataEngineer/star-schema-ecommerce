# Copy to .env (never commit). The devcontainer already exports these via
# devcontainer.json containerEnv — this file exists for local runs without
# Codespaces.

PGHOST=localhost
PGPORT=5432
PGUSER=rundle
PGPASSWORD=rundle_dev_password
PGDATABASE=rundle_warehouse

# Where dbt looks for profiles.yml. The repo ships .dbt/profiles.yml from the
# .example template at devcontainer creation time.
DBT_PROFILES_DIR=./.dbt
